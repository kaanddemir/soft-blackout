{
  "name": "soft-blackout",
  "version": "2.0.0",
  "private": true,
  "description": "Soft Blackout: visually mask text on web pages",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "verify": "node scripts/verify-dist.mjs",
    "package": "npm run build && npm run verify && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify",
    "test:browser": "npm run build && node tests/browser/run.mjs",
    "test:engine-browser": "npm run build && node tests/browser/engine.mjs",
    "test:manual-browser": "npm run build && node tests/browser/manual.mjs",
    "test:poetry-browser": "npm run build && node tests/browser/poetry.mjs",
    "test:pattern-browser": "npm run build && node tests/browser/pattern.mjs",
    "test:ui-browser": "npm run build && node tests/browser/ui.mjs",
    "test:theme-browser": "npm run build && node tests/browser/theme.mjs",
    "test:integration-browser": "npm run build && node tests/browser/integration.mjs",
    "test:render-browser": "npm run build && node tests/browser/render.mjs",
    "test:perf-browser": "npm run build && node tests/browser/perf.mjs",
    "capture:visual": "npm run build && node tests/browser/capture.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
